{"wireMagic": "pb3", "events": [{"tStartMs": 0, "dDurationMs": 3000, "segs": [{"utf8": "[Music] "}]}, {"tStartMs": 3000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 3000, "dDurationMs": 3000, "segs": [{"utf8": "Good morning, friends. "}]}, {"tStartMs": 6000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 6000, "dDurationMs": 3000, "segs": [{"utf8": "Today is Christ the King Sunday. "}]}, {"tStartMs": 9000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 9000, "dDurationMs": 3000, "segs": [{"utf8": "Turn with me to Ephesians chapter 1, verses 13 to 23. "}]}, {"tStartMs": 12000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 12000, "dDurationMs": 3000, "segs": [{"utf8": "Paul prays that the eyes of our hearts would be enlightened, "}]}, {"tStartMs": 15000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 15000, "dDurationMs": 3000, "segs": [{"utf8": "so that we may know the hope to which he has called us. "}]}, {"tStartMs": 18000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 18000, "dDurationMs": 3000, "segs": [{"utf8": "We have this hope as an anchor for the soul, firm and secure. "}]}, {"tStartMs": 21000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 21000, "dDurationMs": 3000, "segs": [{"utf8": "You can try to put your hope in your stuff or your money, but those will fail you. "}]}, {"tStartMs": 24000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 24000, "dDurationMs": 3000, "segs": [{"utf8": "God is the only one who never fails. "}]}, {"tStartMs": 27000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 27000, "dDurationMs": 3000, "segs": [{"utf8": "[Music] "}]}, {"tStartMs": 30000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 30000, "dDurationMs": 3000, "segs": [{"utf8": "Jesus holds power, friends, but he is a loving and just ruler that we can trust. "}]}, {"tStartMs": 33000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 33000, "dDurationMs": 3000, "segs": [{"utf8": "He is the good shepherd who leaves the ninety-nine to search for the one. "}]}, {"tStartMs": 36000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 36000, "dDurationMs": 3000, "segs": [{"utf8": "Augustine said we are restless until we rest in God. "}]}, {"tStartMs": 39000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 39000, "dDurationMs": 3000, "segs": [{"utf8": "So what will you do with Jesus today? Will you let him be king of your life? "}]}, {"tStartMs": 42000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 42000, "dDurationMs": 3000, "segs": [{"utf8": "[Applause] "}]}, {"tStartMs": 45000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 45000, "dDurationMs": 3000, "segs": [{"utf8": "[Music] "}]}, {"tStartMs": 48000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 48000, "dDurationMs": 3000, "segs": [{"utf8": "Good morning, friends. "}]}, {"tStartMs": 51000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 51000, "dDurationMs": 3000, "segs": [{"utf8": "Today is Christ the King Sunday. "}]}, {"tStartMs": 54000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 54000, "dDurationMs": 3000, "segs": [{"utf8": "Turn with me to Ephesians chapter 1, verses 13 to 23. "}]}, {"tStartMs": 57000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 57000, "dDurationMs": 3000, "segs": [{"utf8": "Paul prays that the eyes of our hearts would be enlightened, "}]}, {"tStartMs": 60000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 60000, "dDurationMs": 3000, "segs": [{"utf8": "so that we may know the hope to which he has called us. "}]}, {"tStartMs": 63000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 63000, "dDurationMs": 3000, "segs": [{"utf8": "We have this hope as an anchor for the soul, firm and secure. "}]}, {"tStartMs": 66000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 66000, "dDurationMs": 3000, "segs": [{"utf8": "You can try to put your hope in your stuff or your money, but those will fail you. "}]}, {"tStartMs": 69000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 69000, "dDurationMs": 3000, "segs": [{"utf8": "God is the only one who never fails. "}]}, {"tStartMs": 72000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 72000, "dDurationMs": 3000, "segs": [{"utf8": "[Music] "}]}, {"tStartMs": 75000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 75000, "dDurationMs": 3000, "segs": [{"utf8": "Jesus holds power, friends, but he is a loving and just ruler that we can trust. "}]}, {"tStartMs": 78000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 78000, "dDurationMs": 3000, "segs": [{"utf8": "He is the good shepherd who leaves the ninety-nine to search for the one. "}]}, {"tStartMs": 81000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 81000, "dDurationMs": 3000, "segs": [{"utf8": "Augustine said we are restless until we rest in God. "}]}, {"tStartMs": 84000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 84000, "dDurationMs": 3000, "segs": [{"utf8": "So what will you do with Jesus today? Will you let him be king of your life? "}]}, {"tStartMs": 87000, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 87000, "dDurationMs": 3000, "segs": [{"utf8": "[Applause] "}]}, {"tStartMs": 90000, "aAppend": 1, "segs": [{"utf8": "\n"}]}]}