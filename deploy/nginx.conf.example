# /etc/nginx/sites-available/pellanazarene.conf
# Assumes Cloudflare in front (Full (strict) SSL) and PHP 8.3 FPM.

fastcgi_cache_path /var/cache/nginx/pellanazarene levels=1:2 keys_zone=PELLA:64m inactive=60m max_size=512m;

server {
	listen 80;
	listen [::]:80;
	server_name pellanazarene.org www.pellanazarene.org;
	return 301 https://pellanazarene.org$request_uri;
}

server {
	# Ubuntu 24.04 ships Nginx 1.24, which needs http2 on the listen line.
	listen 443 ssl http2;
	listen [::]:443 ssl http2;
	server_name pellanazarene.org;

	# Cloudflare origin certificate
	ssl_certificate     /etc/ssl/cloudflare/pellanazarene.pem;
	ssl_certificate_key /etc/ssl/cloudflare/pellanazarene.key;

	root  /var/www/pellanazarene/public;
	index index.php;

	client_max_body_size 64m;

	include snippets/pn-security-headers.conf;

	# Real visitor IPs from Cloudflare (keep list current: https://www.cloudflare.com/ips/)
	# include /etc/nginx/snippets/cloudflare-realip.conf;

	# --- Page cache rules ----------------------------------------------------
	set $skip_cache 0;
	if ($request_method = POST)                       { set $skip_cache 1; }
	if ($query_string != "")                          { set $skip_cache 1; }
	if ($request_uri ~* "/wp-admin/|/wp-json/|/xmlrpc.php|wp-.*\.php|/feed/|sitemap") { set $skip_cache 1; }
	if ($http_cookie ~* "comment_author|wordpress_[a-f0-9]+|wp-postpass|wordpress_logged_in") { set $skip_cache 1; }

	location / {
		try_files $uri $uri/ /index.php?$args;
	}

	# Deny rules MUST come before the PHP handler: Nginx uses the first matching
	# regex location in file order, so a deny placed after it never runs.
	# The brand icon for the bare /favicon.ico request (bots, old browsers); pages link their icons themselves.
	location = /favicon.ico { try_files /wp-content/themes/pella-nazarene/assets/images/favicon.ico =404; expires 30d; access_log off; }

	location = /xmlrpc.php { deny all; }
	# WordPress core files that reveal the version or install state. Must stay above the PHP handler.
	location ~* ^/(?:wp-config\.php|wp-config-sample\.php|readme\.html|license\.txt)$ { deny all; }
	location ~ /\.(?!well-known) { deny all; }
	location ~* /wp-content/uploads/.*\.php$ { deny all; }

	location ~ \.php$ {
		include snippets/fastcgi-php.conf;
		fastcgi_pass unix:/run/php/php8.3-fpm.sock;

		fastcgi_cache PELLA;
		include snippets/pn-fastcgi-cache.conf;
		limit_req zone=pn_login burst=5 nodelay;  # only /wp-login.php has a key; see pn-security.conf
		include snippets/pn-security-headers.conf;
	}

	location ~* \.(?:css|js|webp|avif|jpg|jpeg|png|gif|svg|ico|woff2?|mp4)$ {
		expires 30d;
		add_header Cache-Control "public";
		include snippets/pn-security-headers.conf;
		access_log off;
	}
}
