{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "color": {
      "custom": false,
      "customGradient": false,
      "customDuotone": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "gradients": [],
      "duotone": [],
      "palette": [
        {
          "slug": "base",
          "name": "White",
          "color": "#FFFFFF"
        },
        {
          "slug": "contrast",
          "name": "Black",
          "color": "#000000"
        },
        {
          "slug": "accent-3",
          "name": "Navy",
          "color": "#2D3D54"
        },
        {
          "slug": "primary-dark",
          "name": "Navy dark",
          "color": "#263447"
        },
        {
          "slug": "accent-4",
          "name": "Muted text",
          "color": "#576476"
        },
        {
          "slug": "accent-1",
          "name": "Navy tint 20%",
          "color": "#D5D8DD"
        },
        {
          "slug": "accent-2",
          "name": "Navy tint 8%",
          "color": "#EEEFF1"
        },
        {
          "slug": "accent-5",
          "name": "Navy tint 4%",
          "color": "#F7F7F8"
        },
        {
          "slug": "accent-6",
          "name": "Border",
          "color": "color-mix(in srgb, currentColor 20%, transparent)"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "customFontSize": false,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "plus-jakarta-sans",
          "name": "Plus Jakarta Sans",
          "fontFamily": "\"Plus Jakarta Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Plus Jakarta Sans",
              "fontStyle": "normal",
              "fontWeight": "200 800",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/plus-jakarta-sans-normal.woff2"
              ]
            },
            {
              "fontFamily": "Plus Jakarta Sans",
              "fontStyle": "italic",
              "fontWeight": "200 800",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/plus-jakarta-sans-italic.woff2"
              ]
            }
          ]
        },
        {
          "slug": "fira-code",
          "name": "Monospace (system)",
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "1.125rem"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "1.375rem",
          "fluid": {
            "min": "1.25rem",
            "max": "1.5rem"
          }
        },
        {
          "slug": "x-large",
          "name": "X-Large",
          "size": "2rem",
          "fluid": {
            "min": "1.625rem",
            "max": "2.25rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "XX-Large",
          "size": "2.75rem",
          "fluid": {
            "min": "2rem",
            "max": "3.25rem"
          }
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--plus-jakarta-sans)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "fontWeight": "400",
      "letterSpacing": "0",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--accent-3)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--plus-jakarta-sans)",
          "fontWeight": "800",
          "letterSpacing": "-0.01em",
          "lineHeight": "1.15"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--accent-3)"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary-dark)"
          },
          "typography": {
            "textDecoration": "underline"
          }
        },
        ":focus-visible": {
          "outline": {
            "color": "var(--wp--preset--color--accent-3)",
            "offset": "2px",
            "style": "solid",
            "width": "3px"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent-3)",
          "text": "var(--wp--preset--color--base)"
        },
        "border": {
          "radius": "8px"
        },
        "spacing": {
          "padding": {
            "top": "0.8rem",
            "bottom": "0.8rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--plus-jakarta-sans)",
          "fontSize": "var(--wp--preset--font-size--medium)",
          "fontWeight": "800",
          "lineHeight": "1.2",
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary-dark)",
            "text": "var(--wp--preset--color--base)"
          },
          "typography": {
            "textDecoration": "none"
          }
        },
        ":focus-visible": {
          "outline": {
            "color": "var(--wp--preset--color--accent-3)",
            "offset": "3px",
            "style": "solid",
            "width": "3px"
          }
        },
        ":active": {
          "color": {
            "background": "var(--wp--preset--color--primary-dark)",
            "text": "var(--wp--preset--color--base)"
          }
        }
      }
    },
    "blocks": {
      "core/button": {
        "variations": {
          "outline": {
            "color": {
              "text": "var(--wp--preset--color--accent-3)",
              "background": "transparent"
            },
            "border": {
              "color": "var(--wp--preset--color--accent-3)",
              "width": "2px",
              "style": "solid",
              "radius": "8px"
            },
            ":hover": {
              "color": {
                "background": "var(--wp--preset--color--accent-2)",
                "text": "var(--wp--preset--color--primary-dark)"
              }
            }
          }
        }
      },
      "core/quote": {
        "border": {
          "left": {
            "color": "var(--wp--preset--color--accent-3)",
            "width": "4px",
            "style": "solid"
          }
        }
      }
    },
    "css": ":where(.is-layout-flow, .is-layout-constrained) > h2.wp-block-heading:not(:first-child){margin-block-start:2.5rem}:where(.is-layout-flow, .is-layout-constrained) > h3.wp-block-heading:not(:first-child){margin-block-start:2rem}"
  },
  "templateParts": [
    {
      "name": "service-info",
      "title": "Service info",
      "area": "uncategorized"
    }
  ]
}
